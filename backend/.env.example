# -----------------------------------------------------------------------------
# Configuration Back-end (Node.js / Express)
# -----------------------------------------------------------------------------

# Connexion à la base de données MySQL via Prisma
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemple WAMP/XAMPP par défaut : mysql://root:@localhost:3306/golden_hour
DATABASE_URL="mysql://utilisateur:motdepasse@localhost:3306/golden_hour"

# Sécurité : Clé secrète pour l'authentification JWT
JWT_SECRET="votre_cle_secrete_super_securisee_ici"

# --- CONFIGURATION EMAIL (SMTP) ---
# En développement, créez un compte gratuit sur https://mailtrap.io
# Allez dans Sandboxes -> My Sandbox -> Integrations -> Nodemailer pour avoir vos logs
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_user_mailtrap
SMTP_PASS=votre_mot_de_passe_mailtrap
EMAIL_FROM=noreply@goldenhour.com
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
