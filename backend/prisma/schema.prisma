generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. UTILISATEURS
// -----------------------------------------------------------------------------
model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  password  String        
  name      String
  avatar    String?       
  createdAt DateTime      @default(now())

  resetPasswordToken   String?       @unique
  resetPasswordExpires DateTime?
  
  // Relations
  groups         GroupMember[] // Lien vers les groupes auxquels l'utilisateur appartient
  createdGroups  Group[]       @relation("GroupCreator")
  assignedTasks  Task[]        @relation("AssignedTasks")
}

// -----------------------------------------------------------------------------
// 2. GROUPES (Le coeur de l'app)
// -----------------------------------------------------------------------------
model Group {
  id         Int           @id @default(autoincrement())
  name       String
  type       GroupType     @default(FRIENDS)
  inviteCode String        @unique // Le code d'invitation
  coverImage String?
  createdById Int
  createdAt  DateTime      @default(now())

  // Relations
  createdBy  User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members    GroupMember[]
  widgets    Widget[]
}

enum GroupType {
  COUPLE
  FRIENDS
}

// -----------------------------------------------------------------------------
// 3. LA TABLE PIVOT (Membres & Rôles)
// -----------------------------------------------------------------------------
model GroupMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  groupId   Int
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  // Si on supprime un user ou un groupe, ça supprime proprement ce lien (Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Un utilisateur ne peut être qu'une seule fois dans un même groupe
  @@unique([userId, groupId])
}

enum Role {
  ADMIN   // Créateur du groupe (Peut tout faire)
  EDITOR  // Bras droit (Peut gérer les widgets)
  MEMBER  // Simple participant
}

// -----------------------------------------------------------------------------
// 4. LES WIDGETS (Moteur de grille du Dashboard)
// -----------------------------------------------------------------------------
model Widget {
  id        Int        @id @default(autoincrement())
  groupId   Int
  type      WidgetType @default(TEST)
  size      WidgetSize @default(SQUARE)
  position  Int
  data      Json?
  isActive  Boolean    @default(true)

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([groupId, position])
}

model Task {
  id           Int      @id @default(autoincrement())
  widgetId     Int
  title        String
  isCompleted  Boolean  @default(false)
  assignedToId Int?
  createdAt    DateTime @default(now())

  widget       Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  assignee     User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([widgetId])
}

enum WidgetType {
  TEST
  NOTES
  MAP
  MUSIC
  BUDGET
  COUNTDOWN
  TODO
}

enum WidgetSize {
  SQUARE
  RECT
}
