# .env.example - Copier ce fichier et le renommer en .env, puis remplir les valeurs

# Serveur (Node.js)
PORT=3000
NODE_ENV=development

# Base de données (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=golden_hour
DB_USER=root
DB_PASSWORD=

# Authentification
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Frontend (React)
REACT_APP_API_URL=http://localhost:3000/api